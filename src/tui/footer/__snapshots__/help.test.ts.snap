exports[`help appearance fixtures 80x24: help starts below boxed composer and counts, with conversation still visible 1`] = `
"── >[demo] ─────────────────────────────────────────────────────────────────────
model example-model · effort default · fast off
/isolated/demo
example/repo
────────────────────────────────────────────────────────────────────────────────
Conversation record 28
Conversation record 29
Conversation record 30

┌──────────────────────────────────────────────────────────────────────────────┐
│> draft 界                                                                    │
└──────────────────────────────────────────────────────────────────────────────┘
2 agents running │ 1 task │ inbox 1
help · commands & keys                                                  1–9/75
  conversation
  /vim            toggle Vim navigation and editing modes
  /stop           confirm a conversation stop
  /paste-image    attach an image from the clipboard
  /remove-image   remove the last draft image
  /refresh        reload shared local state; active context waits until idle;
                  never runs work
  /retry-images   retry unconfirmed image prompts by original id; never replay
                  consumed input
↑↓ / wheel scroll · pgup/pgdn · home/end · esc close"
`;

exports[`help appearance fixtures 80 columns: full grouped content, including less prominent diagnostics 1`] = `
"  conversation
  /vim            toggle Vim navigation and editing modes
  /stop           confirm a conversation stop
  /paste-image    attach an image from the clipboard
  /remove-image   remove the last draft image
  /refresh        reload shared local state; active context waits until idle;
                  never runs work
  /retry-images   retry unconfirmed image prompts by original id; never replay
                  consumed input
  /tasks          open the task list
  /agents         open agent runs and history
  /images         open images sent to you in the image viewer
  /clear          clear visible chat only; keep model context, history and
                  cache
  /clear-context  clear chat, model context and cache after confirmation
  /questions      browse unanswered questions and respond
  /help           commands and keyboard shortcuts; esc closes

  projects
  /projects                browse projects: enter opens, p pins, d deletes
  /rename <name>           rename conversation and its folder link; keep its
                           identity
  /new [name] [directory]  create a project page
  /close                   close this page; keep its project and history
  /quit                    exit; keep conversation history

  model & accounts
  /effort [level|default]           choose or set project/model reasoning
                                    effort
  /fast [on|off]                    show or set project/model fast mode
  /project [rename|relink]          directory project identity, name and
                                    location
  /project-defaults [save|inherit]  save directory defaults or inherit them in
                                    this conversation
  /model [orch|worker|reviewer]     choose the model for all agents or one
                                    role
  /accounts                         choose a subscription account
  /login claude|codex [profile]     sign in to a subscription account

  keyboard · navigation
  ctrl+n             new orchestrator
  ctrl+z / ctrl+x    previous / next project page
  ctrl+b             open or close projects
  ctrl+t             task list; up/down selects; left folds/parent; right
                     expands or focuses details; details up/down scrolls, left
                     returns; terminal gesture opens PR links; r refresh;
                     ctrl+t/esc returns to draft
  ctrl+q             open the Questions list; arrivals update its count
  ctrl+d (question)  delete shown question; no reply
  pgup/pgdn / wheel  scroll conversation, help or lists (mouse reporting
                     required)
  click ▸            open a run of tool calls (▾ when open); click again to
                     fold it
  ctrl+c             stop conversation and its agents; message to resume;
                     twice within 2s exits
  esc                close panel, else leave agent view, else clear input

  keyboard · editing
  drag / ctrl+o / esc  highlight + auto-copy on release / re-copy / clear
                       highlight
  ctrl+v / ctrl+y      attach clipboard image / remove last image. terminal
                       text paste is unchanged
  shift/alt+enter      new line
  alt+←/→ / alt+b/f    move by word
  alt+⌫ / ctrl+w       delete previous word
  alt+d                delete next word
  home/end / ctrl+a/e  start / end of current line
  ctrl+u / ctrl+k      delete to start / end of current line
  ↑ / ↓                move between input rows, then project input history

  advanced & diagnostics
  /runtime  loaded builds, context observations and background commands
  /usage    measured project tokens, cached input and request time
  /keys     diagnose keys/wheel; ctrl+g keeps draft; esc ends
  /compact  summarize model context; keep full history"
`;

