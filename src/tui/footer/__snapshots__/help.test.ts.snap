exports[`help appearance fixtures 80 columns: full grouped content, including less prominent diagnostics 1`] = `
"  conversation
  /vim            toggle Vim navigation and editing modes
  /clear-context  clear chat, model context and cache after confirmation
  /help           commands and keyboard shortcuts; esc closes

  projects
  /rename <name>  rename conversation and its folder link; keep its identity
  /quit           exit; keep conversation history

  model & accounts
  /effort [level|default]        choose or set project/model reasoning effort
  /fast [on|off]                 show or set project/model fast mode
  /model [orch|worker|reviewer]  choose the model for all agents or one role
  /accounts                      choose a subscription account
  /login claude|codex [profile]  sign in to a subscription account

  keyboard · navigation
  ctrl+n                             new orchestrator
  ctrl+z / ctrl+x                    previous / next project page
  ctrl+a / ctrl+t / ctrl+q / ctrl+b  open the page on Agents / Tasks /
                                     Questions / Projects (Images is its
                                     fourth tab); ctrl+t and ctrl+b also close
                                     it
  pgup/pgdn / wheel                  scroll conversation or help (mouse
                                     reporting required)
  click ▸                            open a run of tool calls (▾ when open);
                                     click again to fold it
  ctrl+c                             stop conversation and its agents; message
                                     to resume; twice within 2s exits
  ctrl+g                             show each key as the terminal sends it;
                                     the draft is kept; esc ends
  esc                                close panel or page, else leave agent
                                     view, else clear input

  keyboard · agents, tasks, questions, images, projects page
  j/k ↑/↓ · gg/G             move · first / last row
  ctrl+d / ctrl+u            half a table page down / up; pgup/pgdn scroll the
                             details
  1–5 · tab/shift+tab · h/l  jump to a tab · next / previous tab (on Tasks h/l
                             ←/→ fold)
  f or / · n/N               find by name as you type (enter keeps, esc
                             restores) · next / previous match
  a · d/D · u · r            show archived · archive one / all (y confirms) ·
                             restore · refresh
  enter                      agent: view transcript · question: choose or type
                             an answer · image: desktop viewer · project: open
  answering                  j/k or a digit choose an option, Other… types
                             one; enter sends; ctrl+d deletes the question;
                             esc cancels
  s · c · t                  Agents: stop · Tasks: abandon · Images: retry
                             unconfirmed image prompts
  p · c · d · n              Projects: pin · close the open page (project
                             kept) · delete · new conversation (inside a
                             project)
  esc / q                    close the page

  keyboard · editing
  drag / ctrl+o / esc  highlight + auto-copy on release / re-copy / clear
                       highlight
  ctrl+v / ctrl+y      attach clipboard image / remove last image. terminal
                       text paste is unchanged
  shift/alt+enter      new line
  alt+←/→ / alt+b/f    move by word
  alt+⌫ / ctrl+w       delete previous word
  alt+d                delete next word
  home/end / ctrl+e    start / end of current line
  ctrl+u / ctrl+k      delete to start / end of current line
  ↑ / ↓                move between input rows, then project input history

  advanced & diagnostics
  /compact  summarize model context; keep full history"
`;

